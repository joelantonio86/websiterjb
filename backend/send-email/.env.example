# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env (ele deve estar no .gitignore).
#
# Localhost (sem deploy):
#   1) preencha R2_* + GOOGLE_APPLICATION_CREDENTIALS
#   2) npm start   →  http://127.0.0.1:8080
#   3) no frontend: VITE_API_BASE=http://127.0.0.1:8080

PORT=8080

# E-mail (opcional em localhost; só necessário para contacto/cadastro)
# GMAIL_USER=
# GMAIL_PASS=

# JWT (use uma chave longa e aleatória em produção)
JWT_SECRET=dev-local-mude-isto

# Usuários administradores (JSON). Use generate-admin-users.js se quiser hashes/complexidade.
# Para localhost podes usar um user simples:
ADMIN_USERS=[{"email":"admin@local.test","password":"senha123","role":"admin"}]

# Firebase / GCP — caminho absoluto para o JSON da service account
# Windows ex.: C:\Users\teu\secrets\rjb-firebase.json
# macOS/Linux ex.: /home/teu/secrets/rjb-firebase.json
GOOGLE_APPLICATION_CREDENTIALS=

# Cloudflare R2 — ficheiros das partituras (mesmo bucket do site)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=bcdce28b176b983ea717e88968b7b032
R2_BUCKET_NAME=rjb-sheets
R2_PUBLIC_BASE_URL=https://pub-934c96bc6fb449a7ad7b3491065976d3.r2.dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Opcional: GCS (só se STORAGE_PROVIDER não for r2)
# GCS_BUCKET_NAME=rjb-admin-files-bucket
